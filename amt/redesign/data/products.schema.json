{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klopikkon.com/amt/redesign/data/products.schema.json",
  "title": "AMT redesign catalogue",
  "description": "One record per AMT SKU. Core fields are the stack contract. Extra fields (listings, priceRaw, homepagePacks, and so on) are allowed and documented in PLAN.md. Values are copied from amtechpl.com; null means the source did not publish that field.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": true,
    "required": [
      "id",
      "sku",
      "name",
      "synonyms",
      "family",
      "subfamily",
      "subfamilySource",
      "cas",
      "formula",
      "mw",
      "purity",
      "packs",
      "structureImage",
      "documents",
      "source",
      "formulaExternal",
      "mwExternal",
      "structureImageExternal",
      "externalSource",
      "mwNominal",
      "mwNominalSource",
      "classDerived",
      "classDerivedSource"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$",
        "description": "URL slug. Lowercase SKU."
      },
      "sku": {
        "type": "string",
        "pattern": "^AMT[A-Z]{1,6}[0-9]{2,5}-[A-Za-z0-9]+$"
      },
      "name": {
        "type": ["string", "null"],
        "description": "Printed name. Null on the May 2025 flyer, which prints structures and CAS numbers but not names."
      },
      "synonyms": {
        "type": "array",
        "items": { "type": "string" }
      },
      "family": {
        "type": "string",
        "enum": ["lipids", "peg", "fluorophores", "organoborons", "other"]
      },
      "subfamily": {
        "type": "string",
        "minLength": 1,
        "description": "Heading AMT prints above the product, copied verbatim."
      },
      "subfamilySource": {
        "type": "object",
        "additionalProperties": true,
        "required": ["heading", "url", "page", "location"],
        "properties": {
          "heading": { "type": "string" },
          "url": { "type": "string" },
          "page": { "type": ["integer", "null"] },
          "location": { "type": "string" },
          "catalogueHeading": { "type": "string" }
        }
      },
      "cas": { "type": ["string", "null"] },
      "formula": {
        "type": ["string", "null"],
        "description": "AMT-published formula only. Null when the catalogue has no formula column."
      },
      "mw": {
        "type": ["number", "null"],
        "description": "AMT-published molecular weight only. Null when the catalogue has no MW column."
      },
      "formulaExternal": { "type": ["string", "null"] },
      "mwExternal": { "type": ["number", "null"] },
      "structureImageExternal": { "type": ["string", "null"] },
      "externalSource": {
        "anyOf": [
          { "type": "null" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "cid", "url"],
            "properties": {
              "name": { "const": "PubChem" },
              "cid": { "type": "integer", "minimum": 1 },
              "url": { "type": "string" }
            }
          }
        ]
      },
      "mwNominal": {
        "type": ["number", "null"],
        "description": "Nominal PEG mass read from the printed name, such as PEG2000. Not an AMT measurement and not a PubChem value."
      },
      "mwNominalSource": {
        "anyOf": [{ "type": "null" }, { "const": "name" }]
      },
      "classDerived": {
        "description": "Browsing class read from the printed product name with data/class-rules.json. Not an AMT heading. Null when no rule matches.",
        "anyOf": [
          { "type": "null" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["derivedFrom", "rules", "boronClass"],
            "properties": {
              "derivedFrom": { "const": "name" },
              "rules": { "const": "data/class-rules.json" },
              "boronClass": { "enum": ["boronic acid", "pinacol ester", "MIDA ester", "trifluoroborate"] },
              "reactiveGroups": {
                "type": "array",
                "minItems": 1,
                "items": { "enum": ["NHS", "maleimide", "DBCO"] }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["derivedFrom", "rules", "architecture", "reactiveGroups"],
            "properties": {
              "derivedFrom": { "const": "name" },
              "rules": { "const": "data/class-rules.json" },
              "architecture": { "anyOf": [{ "type": "null" }, { "enum": ["mPEG", "heterobifunctional", "multi-arm"] }] },
              "reactiveGroups": {
                "anyOf": [
                  { "type": "null" },
                  {
                    "type": "array",
                    "items": { "enum": ["NHS", "maleimide", "azide", "DBCO", "amine", "acid"] }
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["derivedFrom", "rules", "dyeCore"],
            "properties": {
              "derivedFrom": { "const": "name" },
              "rules": { "const": "data/class-rules.json" },
              "dyeCore": { "enum": ["Cy3", "Cy5.5", "Cy5", "Cy7", "cyanine", "FITC", "BODIPY"] },
              "reactiveGroups": {
                "type": "array",
                "minItems": 1,
                "items": { "enum": ["NHS", "maleimide", "DBCO"] }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["derivedFrom", "rules", "reactiveGroups"],
            "properties": {
              "derivedFrom": { "const": "name" },
              "rules": { "const": "data/class-rules.json" },
              "reactiveGroups": {
                "type": "array",
                "minItems": 1,
                "items": { "enum": ["NHS", "maleimide", "DBCO"] }
              }
            }
          }
        ]
      },
      "classDerivedSource": {
        "description": "\"name\" when classDerived was read from the printed product name. Null when classDerived is null.",
        "anyOf": [{ "type": "null" }, { "const": "name" }]
      },
      "purity": {
        "type": ["string", "null"],
        "description": "Exactly as published, including spacing. Null when the row prints no purity, or when two listings of the same SKU disagree (see listings[].purity)."
      },
      "packs": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": true,
          "required": ["size", "price", "currency", "priceText"],
          "properties": {
            "size": { "type": ["string", "null"] },
            "price": { "type": ["number", "null"] },
            "currency": { "type": ["string", "null"] },
            "priceText": { "type": "string" },
            "priceRaw": { "type": ["string", "null"] },
            "listing": { "type": "integer", "minimum": 0 },
            "purity": { "type": ["string", "null"] }
          }
        }
      },
      "structureImage": {
        "type": ["string", "null"],
        "description": "Path relative to amt/redesign/, or null when no image was published for this SKU."
      },
      "documents": {
        "type": "object",
        "additionalProperties": true,
        "required": ["sds", "coa", "datasheet"],
        "properties": {
          "sds": { "type": ["string", "null"] },
          "coa": { "type": ["string", "null"] },
          "datasheet": { "type": ["string", "null"] }
        }
      },
      "source": {
        "type": "object",
        "additionalProperties": true,
        "required": ["url", "pdf", "page"],
        "properties": {
          "url": { "type": "string" },
          "pdf": { "type": ["string", "null"] },
          "page": { "type": ["integer", "null"] }
        }
      }
    }
  }
}
